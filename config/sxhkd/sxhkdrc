# --- Hardware Brightness Controls ---
XF86MonBrightnessUp
    brightnessctl set +5%

XF86MonBrightnessDown
    brightnessctl set 5%-


# --- Volume / Audio Controls (Pipewire / Alsa) ---
XF86AudioRaiseVolume
    pactl set-sink-volume @DEFAULT_SINK@ +5%

XF86AudioLowerVolume
    pactl set-sink-volume @DEFAULT_SINK@ -5%

XF86AudioMute
    pactl set-sink-mute @DEFAULT_SINK@ toggle

# Launch the full XFCE screenshot window with all options
Print
    xfce4-screenshooter

# Directly trigger regional crop selection (drag and drop box)
shift + Print
    xfce4-screenshooter -r

# Directly capture only the active focused window
alt + Print
    xfce4-screenshooter -w

# Toggle Show Desktop
super + d
    if bspc query -N -n .local.window.!hidden > /dev/null; then \
        for win in $(bspc query -N -n .local.window.!hidden); do bspc node "$win" -g hidden=on; done; \
    else \
        for win in $(bspc query -N -n .local.window.hidden); do bspc node "$win" -g hidden=off; done; \
    fi

