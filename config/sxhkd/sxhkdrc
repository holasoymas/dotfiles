# Terminal (Alacritty)
super + Return
    alacritty
    #xfce4-terminal --hide-scrollbar

# Browser (Firefox)
super + b
    brave-browser 

# App launcher (Rofi)
super + space
    rofi -show drun

# Toggle focused window fullscreen / tiled (Same key to toggle back)
super + f
    bspc node -t '~fullscreen'

# Toggle current desktop between normal tiling and monocle (maximized view keeping tabs/bars visible)
super + e
    bspc desktop -l next

# Focus window in a specific direction (Left, Down, Up, Right)
super + {h,j,k,l}
    bspc node -f {west,south,north,east}

# Cycle forward through windows
alt + Tab
    bspc node -f next.local
    #rofi -show window	    

# Cycle backward through windows
alt + shift + Tab
    bspc node -f prev.local

# Close current window
super + q
    bspc node -c

# Switch desktops
super + {1-5}
    bspc desktop -f ^{1-5}

# Restart sxhkd hotkeys
super + Escape
    pkill -USR1 -x sxhkd

# Quit session
super + shift + q
    bspc quit

